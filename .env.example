# Copie para .env (local) ou cadastre no hPanel > Node.js Web App > Variáveis de ambiente.

# Modo demonstração: "/" e "/demo" mostram o protótipo; as áreas reais ficam fechadas. Apague (ou "false") quando o banco estiver pronto.
NEXT_PUBLIC_DEMO_MODE=true

# Banco MySQL da Hostinger (hPanel > Bancos de dados > MySQL). Com o app na mesma conta, o servidor é "localhost".
# Se a senha tiver símbolos (@ : / # ? %), troque pelo código (%40 %3A %2F %23 %3F %25) ou use uma senha só com letras e números.
MYSQL_URL=mysql://USUARIO:SENHA@localhost:3306/BANCO

# Segredo longo e aleatório (mínimo 32 caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Endereço público do site (links e cookies). Ex.: https://app.seudominio.com.br
APP_URL=

# Pasta no servidor, FORA da pasta pública, para fotos e áudios. Ex.: /home/SEU_USUARIO/bentonutri-arquivos
STORAGE_DIR=

# Opcional: envio do código de acesso do paciente por SMS via webhook de um provedor. Vazio = o nutricionista envia o código pelo WhatsApp.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

